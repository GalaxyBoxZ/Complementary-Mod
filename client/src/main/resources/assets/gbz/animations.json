{
  "default": "fist",
  "debugLogging": false,
  "debugOverlay": false,
  "interpolationTicks": 3,
  "globalSpeedMultiplier": 1.0,
  "mappings": [
    {
      "animation": "pickaxe",
      "match": [ "minecraft:*_pickaxe", "gbz:pickaxe/*" ]
    },
    {
      "animation": "dagger",
      "match": [ 
        "gbz:weapon/cosmetic/rank1",
        "gbz:weapon/cosmetic/trainee"
      ]
    },
    {
      "animation": "axe",
      "match": [ "gbz:weapon/cosmetic/helper" ]
    },
    {
      "animation": "sword",
      "match": [
        "minecraft:*_sword", "gbz:weapon/coal", "gbz:weapon/emberite",
        "gbz:weapon/solarite", "gbz:weapon/arcanite",
        "gbz:weapon/emerald", "gbz:weapon/verdanite",
        "gbz:weapon/cosmetic/rank2"
      ]
    },
    {
      "animation": "katana",
      "match": [ 
        "gbz:weapon/cosmetic/rank3",
        "gbz:weapon/cosmetic/dev"
      ]
    },
    {
      "animation": "longsword",
      "match": [ "gbz:weapon/cosmetic/rank4" ]
    },
    {
      "animation": "greataxe",
      "match": [ 
        "gbz:weapon/cosmetic/mod",
        "gbz:weapon/cosmetic/builder"
      ]
    },
    {
      "animation": "broadsword",
      "match": [ "gbz:weapon/cosmetic/rank5" ]
    },
    {
      "animation": "warglaive",
      "match": [ "gbz:weapon/cosmetic/admin" ]
    },
     {
      "animation": "scythe",
      "match": [ "gbz:weapon/cosmetic/owner" ]
     }
  ]
}