{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "GBZ server companion mod.",
  "icon": "assets/gbz/icon.png",
  "authors": [
    "Hiramachi"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "gbz.complementary.client.GBZComplementaryClient"
      }
    ]
  },
  "mixins": [
    "gbz.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": ">=${minecraft_version} <=1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.2+kotlin.2.1.20"
  }
}
